# Copy this file to ".env" and fill in your own values.
# Generate an API key + token at: https://trello.com/power-ups/admin
#
# The app runs on MOCK data until USE_MOCK is set to "false".

USE_MOCK=true

# Your Trello API key
TRELLO_API_KEY=

# Your Trello API token
TRELLO_TOKEN=

# The board you want the gadget to read.
# You can leave this blank and pick a board from the UI once credentials are set.
TRELLO_BOARD_ID=

# Auto-refresh interval in milliseconds.
#   0  = manual only — the app fetches on open and when you click the ⟳
#        Refresh button (recommended; no background API calls).
#   >0 = also auto-refresh in the background this often (e.g. 60000 = 60s).
POLL_INTERVAL_MS=0

# Granularity for the "Cards per column over time" chart history.
#   day  = one data point per day (default). Refreshing multiple times a day
#          just updates that day's point to the latest counts.
#   hour = one data point per hour.
HISTORY_BUCKET=day
